# syntax=docker/dockerfile:1.7
#
# One-shot migrator for the Wiki module. Compose runs this once per `up`
# with restart: "no" and the API server waits on
# service_completed_successfully. Keeping migrations out of the API binary
# makes rollbacks predictable and prevents racey leader-election at
# startup.

FROM golang:1.25-alpine AS build
WORKDIR /src

ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

COPY backend/go.mod backend/go.sum* ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    (test -f go.sum && go mod download) || go mod tidy

COPY backend ./

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath -ldflags "-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/migrate /migrate
USER nonroot:nonroot
ENTRYPOINT ["/migrate"]
