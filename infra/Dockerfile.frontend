# syntax=docker/dockerfile:1.7
#
# Wiki frontend image. Rsbuild builds a static bundle; nginx serves it
# and forwards /api/ to the backend.
#
# The image is the same for every installation: the sign-in address and the
# other web app settings are read at start-up from /config.json, which nginx
# serves from /etc/conservices/config.json. Mount your own file there (a
# ConfigMap in Kubernetes, a bind mount in Docker Compose). The default file
# below names no domain, so an unconfigured app says "Not configured yet".
# Docs: https://aglelectronics.github.io/con-services/modules/wiki/configuration/#web-app-settings-configjson
#
# Build context: the module directory, for example
#   docker build -f infra/Dockerfile.frontend -t wiki-frontend .

FROM node:22-alpine AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund

COPY frontend/ ./

# Release version shown in the app; CI passes it on tag builds.
ARG WIKI_VERSION=dev
ENV WIKI_VERSION=$WIKI_VERSION

RUN npm run build

# nginx-unprivileged runs as the "nginx" user (UID 101) and listens on 8080:
# a non-root process cannot bind ports below 1024. The pid file and the
# temporary files live in /tmp. The upgrade picks up Alpine security fixes
# published after the base image was built.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS runtime
USER root
RUN apk upgrade --no-cache
COPY --from=build /src/dist /usr/share/nginx/html
ARG NGINX_CONF=nginx.conf
COPY infra/${NGINX_CONF} /etc/nginx/conf.d/default.conf
# Security headers for the web app (shared snippets, development origins;
# the Helm chart mounts its own rendered from values over these files).
# The frame-self snippet is only for /silent-callback.html.
COPY infra/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY infra/security-headers-frame-self.conf /etc/nginx/snippets/security-headers-frame-self.conf
COPY infra/frontend-config/default.json /etc/conservices/config.json
USER 101
EXPOSE 8080
