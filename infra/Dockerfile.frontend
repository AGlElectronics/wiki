# syntax=docker/dockerfile:1.7
#
# Wiki frontend image. Rsbuild inlines VITE_* envs at build time, so
# auth-mode / OIDC authority / client id must be passed via --build-arg
# (or docker-compose `args:`) when AUTH_MODE=oidc. Dev builds get sane
# empty defaults.
#
# Build context: the parent `wiki/` directory. Example:
#
#   cd wiki
#   docker build -f infra/Dockerfile.frontend -t wiki-frontend .

FROM node:22-alpine AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund

COPY frontend/ ./

ARG VITE_AUTH_MODE=dev
ARG VITE_OIDC_AUTHORITY=
ARG VITE_OIDC_CLIENT_ID=
ARG VITE_OIDC_SCOPE=openid profile email
ARG VITE_API_BASE_URL=
ARG VITE_PRODUCT_NAME=Wiki
ARG WIKI_VERSION=dev

ENV VITE_AUTH_MODE=$VITE_AUTH_MODE \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_PRODUCT_NAME=$VITE_PRODUCT_NAME \
    WIKI_VERSION=$WIKI_VERSION

# Fail fast if someone asks for oidc but forgets authority/client id (avoids
# "undefined" strings in the compiled bundles that silently break the
# login flow at runtime).
RUN if [ "$VITE_AUTH_MODE" = "oidc" ] && { [ -z "$VITE_OIDC_AUTHORITY" ] || [ -z "$VITE_OIDC_CLIENT_ID" ]; }; then \
      echo "Dockerfile: VITE_AUTH_MODE=oidc requires non-empty VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID (pass --build-arg)."; \
      exit 1; \
    fi

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /src/dist /usr/share/nginx/html
ARG NGINX_CONF=nginx.conf
COPY infra/${NGINX_CONF} /etc/nginx/conf.d/default.conf
EXPOSE 80
