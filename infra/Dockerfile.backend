# syntax=docker/dockerfile:1.7
#
# Wiki API server image. Does NOT run migrations — those live in a
# separate image (Dockerfile.migrate) that Compose orchestrates as a
# one-shot. The API container MUST never auto-migrate (techstack.md §4).
#
# No sqlc step: Wiki uses hand-written pgx queries in this slice (like HR
# pre-sqlc). When sqlc lands, mirror Rally's Dockerfile.backend.

FROM golang:1.25-alpine AS build
WORKDIR /src

ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

COPY backend/go.mod backend/go.sum* ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    (test -f go.sum && go mod download) || go mod tidy

COPY backend ./

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath \
        -ldflags "-s -w -X github.com/AGlElectronics/wiki/backend/internal/app.Version=${VERSION}" \
        -o /out/server ./cmd/server
# Edit buffer (WIKI_BUFFER_DIR). A fresh named volume copies this
# directory's owner, so nonroot can write to it.
RUN mkdir -p /out/buffer

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/server /server
COPY --from=build --chown=65532:65532 /out/buffer /var/lib/wiki/buffer
# Container listens on :8080 (HTTP_ADDR default in compose). The HOST-side
# mapping is wired by Compose / K8s — host port 8140 is Wiki's reserved
# dev port, but containers all speak :8080 internally so service mesh /
# sidecar config stays uniform across every module in the ecosystem.
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/server"]
