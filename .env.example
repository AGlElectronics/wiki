# Wiki — local development environment.
#
# Copy to `.env`, adjust what you need, then `docker compose -f infra/docker-compose.yml up`.
# Reserved host ports: backend 8140, frontend 3007, postgres 5439.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8140
HTTP_ADDR=:8140

# PostgreSQL (matches infra/docker-compose.yml defaults).
DATABASE_URL=postgres://wiki:wiki@localhost:5439/wiki?sslmode=disable

# ---------------------------------------------------------------------------
# Auth
#   dev  — X-Dev-User (identity) + X-Dev-Groups (simulated IdP groups).
#   oidc — Bearer JWT verified via OIDC discovery (set issuer + client id).
# ---------------------------------------------------------------------------
AUTH_MODE=dev
DEV_DEFAULT_USER=dev-admin
DEV_DEFAULT_GROUPS=wiki-admin
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Access config file (roles & OIDC-group → role bindings). Optional in dev
# (the built-in catalog is used), required for production OIDC deployments.
# ACCESS_CONFIG_PATH=/etc/wiki/access-config.toml

# ---------------------------------------------------------------------------
# Branding
#   Standalone: the local brand.json below (or the built-in default).
#   Paired with Den (Settings → Den connection): Den's name, logo and
#   colours override it; the pairing is stored in the database.
# ---------------------------------------------------------------------------
# Optional: path to a server-side brand.json for /api/v1/brand.
BRAND_LOCAL_PATH=
# Optional: replaces the host of the pasted Den pairing URL when this backend
# reaches Den at a different address than the browser does.
DEN_INTERNAL_URL=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3007
SHUTDOWN_TIMEOUT=15s

# Public share links (read-only pages for people without an account).
# Standalone switch; once paired with Den, the wiki_public_links org
# setting wins. Off by default.
PUBLIC_LINKS_ENABLED=false

# ---------------------------------------------------------------------------
# Offboarding (HR integration)
# ---------------------------------------------------------------------------
# HR calls POST /api/internal/offboarded with this bearer token when an
# account is deleted; the person's private space is handed to the wiki
# admins and removed after the grace period. Empty = internal API off.
WIKI_SERVICE_TOKEN=
WIKI_OFFBOARD_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Object storage (S3-compatible). Page content and uploads live here.
# MinIO is LOCAL DEV ONLY; production uses a managed bucket.
# Empty S3_ENDPOINT turns storage (and live editing) off.
# ---------------------------------------------------------------------------
# Live edits are buffered here for up to ~5s before shipping to S3. Keep it
# on a persistent volume; run one backend replica.
WIKI_BUFFER_DIR=./data/buffer
S3_ENDPOINT=http://localhost:9040
S3_BUCKET=wiki-data-dev
S3_ACCESS_KEY_ID=wiki
S3_SECRET_ACCESS_KEY=wikiwikidev
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Frontend (rsbuild inlines these at build time; set BEFORE building the image).
# ---------------------------------------------------------------------------
# Leave empty when the SPA is served behind the same origin as /api (nginx).
VITE_API_BASE_URL=http://localhost:8140
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_PRODUCT_NAME=Wiki
